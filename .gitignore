.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# Generated data: ignore by default
data/processed/*

# Keep folder placeholder
!data/processed/.gitkeep

# Keep market surfaces needed for calibration / OOS
!data/processed/full_surfaces/
!data/processed/full_surfaces/**

!data/processed/sparse_historical_surfaces/
!data/processed/sparse_historical_surfaces/**

# Keep the underlying and Treasury histories used by the project
!data/processed/gld_daily_history.csv
!data/processed/usd_treasury_history.csv

# Generated results remain local
outputs/*
!outputs/.gitkeep